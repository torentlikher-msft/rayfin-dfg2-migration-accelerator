# Copy to .env.local for development or .env.production.local for deployment.
# Fill in both public identifiers from your single-tenant Entra SPA registration.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=

# For local development against a deployed Rayfin backend, uncomment and fill in:
# VITE_RAYFIN_API_URL=your-deployed-backend-api-url
# VITE_RAYFIN_PUBLISHABLE_KEY=your-backend-publishable-key

# Register http://localhost:5173/redirect.html as a Single-page application callback.
# Add the deployed app's exact HTTPS origin + /redirect.html before sharing it.
# Hosted builds use Rayfin's runtime configuration for the backend connection.
# Never put USER_DELEGATION_PRIVATE_KEY or Microsoft access tokens in VITE_ settings.
